#!/bin/sh
# Usage: scripts/seams [-provider DIR] [-all] FROM TO        (for example: scripts/seams v0.9.0 v0.10.0)
#
# Lists the exported symbols whose behavior changed between two revisions, and with a consumer checkout
# (-provider DIR, or the environment variable SEAMS_PROVIDER) the ones it uses: the seams a release
# should be tested against the consumer for. A thin wrapper: the work is done by internal/seams (Go,
# tested), see its package comment and RELEASING.md.
set -eu
cd "$(git rev-parse --show-toplevel)"
exec go run ./internal/seams "$@"
