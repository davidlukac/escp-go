#!/bin/sh
# Pre-commit: the CI checks, locally, before the commit exists.
#   gofmt, go vet (also -tags live), golangci-lint, then tests with -race and the
#   coverage policy (`make pre-commit`). Skipped when nothing that affects the Go
#   build or tests is staged. A staged workflow file is checked with actionlint (pinned in
#   devtools/go.mod) whatever else is staged. Enable once per clone with `make hooks`.
#
# Do not bypass with --no-verify: a red hook is the same red CI would show.
set -eu
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

command -v go >/dev/null 2>&1 || {
  echo "pre-commit: 'go' is required but not on PATH" >&2
  exit 1
}

# Workflow files: actionlint (with shellcheck when it is installed), the pinned version.
if printf '%s\n' "$staged" | grep -q '^\.github/'; then
  echo "pre-commit: make actionlint"
  make actionlint
fi

# Prose and configuration are American English too, and a commit that touches only those (a guide, a
# workflow) would otherwise skip every check below: spell them first, it takes a second.
if printf '%s\n' "$staged" | grep -Eq '(\.(md|ya?ml|json|sh)$|^Makefile$)'; then
  echo "pre-commit: make spell"
  make spell
fi

# Only these paths can change build, lint or test results.
if ! printf '%s\n' "$staged" | grep -Eq '(\.go$|^go\.(mod|sum)$|^\.golangci\.yml$|^Makefile$|^\.githooks/|^devtools/|^safety/compatibility\.json$|^README\.md$)'; then
  echo "pre-commit: no Go-relevant changes staged, skipping checks"
  exit 0
fi

echo "pre-commit: make pre-commit (gofmt, vet, lint, tests with -race and the coverage policy)"
exec make pre-commit
